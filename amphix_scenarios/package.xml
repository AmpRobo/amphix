<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amphix_scenarios</name>
  <version>0.0.0</version>
  <description>Example AmphiX scenarios (BlueROV2, BlueBoat, Sonobot, wind farm) with their meshes and textures.</description>
  <maintainer email="bvibhav@yahoo.co.in">Vibhav B</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amphix_ros_wrapper</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
